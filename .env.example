IN_URL=https://invoicing.example.com
IN_TOKEN=your-invoice-ninja-api-token
# optional: existing bank account id in Invoice Ninja (otherwise looked up / created by IBAN)
IN_BANK_INTEGRATION_ID=
# optional: extra CA/intermediate certificate if your server sends an incomplete chain
IN_CA_FILE=
# optional: invoices from a previous program imported with ebinterface2ninja.py (prefix) - payments before this date use the old numbers
IN_LEGACY_PREFIX=PS-
IN_LEGACY_UNTIL=
